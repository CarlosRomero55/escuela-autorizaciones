# Copiar a .env y reemplazar todos los valores. Nunca subir .env al repositorio.

# Base de datos. Local: docker compose. Demo: cadena de conexión de Neon (incluye sslmode=require).
DATABASE_URL=postgresql+psycopg://escuela:escuela_dev@localhost:5432/escuela

# Clave para firmar sesiones. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-un-valor-aleatorio-largo

# Clave para HMAC de tokens y códigos guardados como hash. Distinta de SECRET_KEY.
TOKEN_HMAC_KEY=cambiar-por-otro-valor-aleatorio-largo

# Entorno: development | production
APP_ENV=development

# Zona horaria de la escuela (para mostrar fechas)
TIMEZONE=America/Guayaquil

# Minutos de vigencia del código de recogida
PICKUP_CODE_TTL_MINUTES=10

# Intentos máximos por código de recogida
PICKUP_CODE_MAX_ATTEMPTS=5
