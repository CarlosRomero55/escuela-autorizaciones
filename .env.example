# Copiar a .env y reemplazar los valores. Nunca subir .env al repositorio.

# Base de datos. Local: docker compose. Nube: cadena de conexión del proveedor (con sslmode=require).
DATABASE_URL=postgresql+psycopg://escuela:escuela_dev@localhost:5432/escuela

# Clave para HMAC de tokens, códigos y huellas de dispositivo.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_HMAC_KEY=cambiar-por-un-valor-aleatorio-largo

# Clave AES-256 para cifrar documentos y secretos TOTP. Obligatoria. Si se pierde, esos datos no se recuperan.
# Generar con: python -c "from app.crypto import generar_clave; print(generar_clave())"
ENCRYPTION_KEY=

# Entorno: development | production (production exige HTTPS y oculta /docs)
APP_ENV=development

# Sesiones
SESION_INACTIVIDAD_MINUTOS=30
SESION_MAXIMA_HORAS=12
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# Enlaces de cuenta
ACTIVACION_HORAS=72
RECUPERACION_MINUTOS=30

# Decisión de la dirección: grado desde el que los estudiantes tienen cuenta propia
GRADO_MINIMO_CUENTA_ESTUDIANTE=5

# Autorizaciones y recogida
PICKUP_CODE_TTL_MINUTES=10
PICKUP_CODE_MAX_ATTEMPTS=5
FAMILY_LINK_TTL_DAYS=30

# Demo pública: muestra usuarios de prueba y el código TOTP vigente en la pantalla de acceso.
# Nunca activar con datos reales.
DEMO_MODE=true
# Contraseña de los usuarios de demo (mínimo 10 caracteres)
DEMO_PASSWORD=cambiar-por-una-clave-de-demo
